# Environment variables example
# Copy this file to .env and update with your actual values

# API Configuration
API_BASE_URL=https://localhost:7148
API_HOST=localhost
API_PORT=7148

# Angular Dev Server
ANGULAR_PORT=60749
ANGULAR_HOST=localhost

# HTTPS Configuration (optional)
ASPNETCORE_HTTPS_PORT=7148
ASPNETCORE_URLS=https://localhost:7148

# Environment
NODE_ENV=development
